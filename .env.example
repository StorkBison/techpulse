# Copy to .env and fill in. Everything is optional - the app runs with defaults.

# Claude enrichment. Without a key, TechPulse uses its offline keyword enricher.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
INTERESTS=AI/LLMs, automation, Python, developer tools, DevOps, security

# Alerts: stories with relevance >= threshold go to Slack (or the log if unset).
ALERT_THRESHOLD=8
SLACK_WEBHOOK_URL=

# Scheduler
SCHEDULE_ENABLED=true
SCHEDULE_INTERVAL_MINUTES=30

# Scraper: "live" hits news.ycombinator.com; "fixture" replays tests/fixtures (offline)
SCRAPER_SOURCE=live
SCRAPER_PAGES=1
# Optional: use an installed browser instead of Playwright's bundled Chromium
# BROWSER_CHANNEL=chrome

# Local default is SQLite; docker-compose overrides this with PostgreSQL.
DATABASE_URL=sqlite:///./data/techpulse.db
